# LLM gateway (OpenAI-compatible)
LLM_BASE_URL=https://aigw.asiainfo.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=aliyun/qwen3.6-plus
# Per-call HTTP timeout in seconds. Reasoning models (qwen3.x-plus,
# deepseek-v3.2) emit large `reasoning_content` blocks even on short
# prompts, so 30 s is too tight for the planner + finalize round-trips.
# Default in-code is 120 s; raise it if your gateway is slow.
LLM_TIMEOUT_S=120

# Available models on this gateway:
#   aliyun/qwen3.6-plus      (default — balanced)
#   aliyun/deepseek-v3.2     (reasoning)
#   aliyun/kimi-k2.5         (long context)
#   aliyun/glm-5
#   aliyun/MiniMax-M2.5

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Public origin used to assemble `report_html_url` in the submission contract.
# Must be reachable by the organizer's grader without authentication.
APP_PUBLIC_URL=http://localhost:8000
