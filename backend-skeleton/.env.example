# ============================================================
# Table-Talker 后端环境变量 · 模板
# 1) 在仓库根目录拷贝 .env.example → .env，填入真实 Key
# 2) Docker Compose 会从根目录 .env 读取；本地开发也可以拷一份到这里
# ============================================================

# ============ 主办方亚信 AI 网关 ============
LLM_API_KEY=sk-xxxxx
LLM_BASE_URL=https://aigw.asiainfo.com/v1

# 模型路由（5 个可选）：
#   aliyun/qwen3.6-plus      ← 默认主模型
#   aliyun/deepseek-v3.2     ← 小模型（Router / Critic）
#   aliyun/kimi-k2.5         ← 长上下文（报告超长 prompt）
#   aliyun/MiniMax-M2.5      ← 备用 1
#   aliyun/glm-5             ← 备用 2
LLM_MODEL_DEFAULT=aliyun/qwen3.6-plus
LLM_MODEL_SMALL=aliyun/deepseek-v3.2
LLM_MODEL_LONG=aliyun/kimi-k2.5
LLM_MODEL_FALLBACK=aliyun/MiniMax-M2.5
LLM_MODEL_FALLBACK_2=aliyun/glm-5

# ============ Mock 模式 ============
# true = 返回 design-source/data.js 一致的 mock 数据（无需 Key）
MOCK_MODE=false

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============ 数据 ============
DATA_DIR=./data
SCHEMAS_FILE=./schemas.json

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ 沙盒 ============
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEM_MB=1024

# ============ 评委账号 token ============
JUDGE_TOKENS=judge-token-1,judge-token-2
